{
  "family": "react-java-mysql",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::929123273508:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "929123273508.dkr.ecr.us-east-2.amazonaws.com/react-java-mysql-frontend:ecs",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "START"
        }
      ]
    },
    {
      "name": "backend",
      "image": "929123273508.dkr.ecr.us-east-2.amazonaws.com/react-java-mysql-backend:latest",
      "essential": true,
      "environment": [
        { "name": "MYSQL_HOST", "value": "127.0.0.1" },
        { "name": "MYSQL_PASSWORD", "value": "db-57xsl" }
      ],
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "dependsOn": [
        {
          "containerName": "db",
          "condition": "HEALTHY"
        }
      ]
    },
    {
      "name": "db",
      "image": "mariadb:10.6.4-focal",
      "essential": true,
      "environment": [
        { "name": "MYSQL_DATABASE", "value": "example" },
        { "name": "MYSQL_ROOT_PASSWORD", "value": "db-57xsl" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p$MYSQL_ROOT_PASSWORD --silent"],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },
      "portMappings": [
        {
          "containerPort": 3306,
          "hostPort": 3306,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
